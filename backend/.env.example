# Supabase project settings (Settings -> API and Settings -> Database in the Supabase dashboard)
# ANON_KEY / SERVICE_ROLE_KEY are labeled "Publishable key" / "Secret key" in
# newer Supabase dashboards -- same fields, Supabase renamed them in the UI.
# No JWT secret needed -- this project verifies tokens against the public
# JWKS endpoint (https://your-project-ref.supabase.co/auth/v1/jwks), not a
# shared secret. See app/core/security.py.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Direct Postgres connection used by SQLAlchemy/asyncpg. Use the "connection
# pooling" (pgbouncer, port 6543) string for normal request traffic; the
# scoring/backup jobs can use the direct (port 5432) string if needed.
SUPABASE_DB_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
