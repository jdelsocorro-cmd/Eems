# Admin-level DB credential used ONLY for running schema migrations
# (supabase/migrations/*.sql) -- distinct from backend/.env, which holds the
# app's own restricted eems_app credential. Never used by the running app,
# never committed (supabase/.env is gitignored).
#
# Get this from: Supabase dashboard -> Connect -> Type: URI -> Transaction
# pooler -> copy the password from "Reset database password" if you don't
# have it saved. Fill it into the string below, save as supabase/.env
# (not .env.example), and it stays local from then on.
SUPABASE_DB_ADMIN_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres
